# Copy this file to .env and fill it in. The .env file is private: never share it or put it in a public place.

# Online plan payments with Cashfree. Leave PAYMENT_MODE=mock to test without charging anyone.
PAYMENT_MODE=cashfree
CASHFREE_ENV=sandbox
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
# Public https address of this server (needed for the webhook and the payment return page)
PUBLIC_URL=

# Admin panel login
ADMIN_USER=admin
ADMIN_PASSWORD=admin123
