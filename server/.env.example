# Copy this file to .env and fill it in. The .env file is private: never share it or put it in a public place.

# Online plan payments with Cashfree. Leave PAYMENT_MODE=mock to test without charging anyone.
PAYMENT_MODE=cashfree
CASHFREE_ENV=sandbox
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
# Public https address of this server (needed for the webhook and the payment return page)
PUBLIC_URL=

# Admin panel login
ADMIN_USER=admin
ADMIN_PASSWORD=admin123

# On a shared server: listen only on this machine (nginx forwards to it), and keep Redis keys apart from other projects.
# HOST=127.0.0.1
# QUEUE_PREFIX=dailylist
# REDIS_URL=redis://127.0.0.1:6379/1

# Real SMS (login codes) with Twilio. Without these the server only writes the message to its log.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# optional, used instead of TWILIO_FROM when set:
# TWILIO_MESSAGING_SERVICE_SID=
# added in front of phone numbers saved without a country code
# SMS_COUNTRY_CODE=+91

# Test accounts for the Google Play reviewers (the fixed login code is only for these numbers).
# After setting them, run once: node scripts/seed-review.js
# REVIEW_PHONES=9000000098,9000000099
# REVIEW_OTP=123456
